---
import type { Project } from '@data'

interface Props {
  project: Project
}

const { project } = Astro.props
const { name, description, url, language, stars } = project

const languageColors: Record<string, string> = {
  TypeScript: 'badge-info',
  JavaScript: 'badge-warning',
  'C#': 'badge-success',
  Lua: 'badge-primary',
}

const badgeColor = languageColors[language] || 'badge-neutral'
---

<article
  class="card bg-base-200 shadow-xl transition-transform hover:scale-[1.02]">
  <div class="card-body">
    <h2 class="card-title font-serif text-2xl">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary no-underline hover:no-underline">
        {name}
      </a>
    </h2>
    <p class="text-base-content/80 font-sans">{description}</p>
    <div class="card-actions mt-4 items-center justify-between">
      <div class="flex items-center gap-2">
        <span class={`badge ${badgeColor} font-sans text-xs`}>{language}</span>
        {
          stars > 0 && (
            <span class="text-base-content/60 flex items-center gap-1 font-sans text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="currentColor"
                viewBox="0 0 24 24">
                <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z" />
              </svg>
              {stars}
            </span>
          )
        }
      </div>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-sm font-sans no-underline hover:no-underline">
        View on GitHub
      </a>
    </div>
  </div>
</article>
