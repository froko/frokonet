---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, tags } = post.data

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate)
---

<article
  class="card bg-base-200 shadow-xl transition-transform hover:scale-[1.02]">
  <a
    href={`/blog/${post.slug}`}
    class="card-body no-underline hover:no-underline">
    <h2 class="card-title hover:text-primary font-serif text-2xl">
      {title}
    </h2>
    <p class="font-sans text-sm font-light text-gray-500">{formattedDate}</p>
    <p class="text-base-content/80 font-sans">{description}</p>
    {
      tags.length > 0 && (
        <div class="card-actions mt-4 justify-end">
          {tags.map((tag: string) => (
            <div class="badge badge-outline font-sans text-xs">{tag}</div>
          ))}
        </div>
      )
    }
  </a>
</article>
