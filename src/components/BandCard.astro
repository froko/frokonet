---
import type { Band } from '@data'

interface Props {
  band: Band
}

const { band } = Astro.props
const { name, url, description, image } = band
---

<article
  class="band-card card bg-base-200 shadow-xl transition-transform hover:scale-[1.02]">
  <figure>
    <img src={image} alt={name} class="h-48 w-full object-cover" />
  </figure>
  <div class="card-body">
    <h2 class="card-title font-serif text-2xl">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary no-underline hover:no-underline">
        {name}
      </a>
    </h2>
    {description && <p class="text-base-content/80 font-sans">{description}</p>}
    <div class="card-actions justify-end">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-sm font-sans no-underline hover:no-underline">
        Visit Website
      </a>
    </div>
  </div>
</article>

<style>
  a {
    text-decoration: none !important;
  }

  .band-card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
  }

  .band-card .card-body {
    display: flex;
    flex-direction: column;
  }

  .band-card .card-actions {
    margin-top: auto;
  }
</style>
