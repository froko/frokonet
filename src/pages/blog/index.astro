---
import { Page } from '@layout'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

import PostCard from '../../components/PostCard.astro'

const allPosts = await getCollection('blog')
const posts = allPosts
  .filter((post: CollectionEntry<'blog'>) => !post.data.draft)
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
---

<Page
  title="Blog | Patrick Ineichen"
  description="Thoughts on software engineering, web development, music, and technology">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="mb-8 font-serif text-4xl font-bold md:text-5xl">Blog</h1>
    <p class="mb-12 font-sans text-lg font-light text-gray-500">
      Thoughts on software engineering, web development, and technology
    </p>

    <div class="grid gap-6">
      {posts.map((post: CollectionEntry<'blog'>) => <PostCard {post} />)}
    </div>

    {
      posts.length === 0 && (
        <div class="text-center text-gray-500">
          <p>No posts yet. Check back soon!</p>
        </div>
      )
    }
  </div>
</Page>
